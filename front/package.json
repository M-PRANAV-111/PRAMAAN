{
  "name": "pramaan-front",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "PRAMAAN web client — React 19 + TypeScript + Tailwind CSS v4, bundled with esbuild",
  "scripts": {
    "start": "node scripts/start.mjs",
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:offline": "tsc -p tsconfig.offline.json --noEmit"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "0.28.2",
    "tailwindcss": "4.3.3",
    "typescript": "^6.0.0"
  }
}
