# PRAMAAN configuration. Copy to .env and fill in. Never commit real values.
APP_ENV=development                 # development | test | production
JWT_SECRET=change-me-to-64-random-characters   # production refuses anything shorter than 32 chars
JWT_TTL_MINUTES=30
COOKIE_SECURE=false                 # must be true in production (HTTPS only)
DATA_DIR=./backend/var              # database, private file store, benchmark report
# DATABASE_PATH=                    # defaults to $DATA_DIR/pramaan.sqlite3
FRONT_DIST=./front/dist             # serve the built web client from the API process (optional)
CORS_ORIGINS=                       # only if the web client is served from another origin
MAX_UPLOAD_BYTES=10485760
MAX_PDF_PAGES=40
LOGIN_RATE_PER_MINUTE=10
UPLOAD_RATE_PER_MINUTE=30
WORKER_THREADS=1                    # 0 = process synchronously (tests)
TESSERACT_CMD=                      # path to tesseract if not on PATH
SEED_DEMO_PASSWORD=                 # optional fixed password for demo accounts (random if empty)
# External integrations stay off until AICTE authorizes them. No credentials are needed for the demo.
DIGILOCKER_ENABLED=false

# Account links and email. Console writes private .eml files for local development only.
PUBLIC_BASE_URL=http://localhost:8000
EMAIL_PROVIDER=console             # console | smtp | resend; console is forbidden in production
EMAIL_FROM="PRAMAAN prototype <noreply@pramaan.local>"
SMTP_HOST=
SMTP_PORT=587                      # STARTTLS is mandatory for SMTP
SMTP_USER=
SMTP_PASSWORD=
RESEND_API_KEY=
NOTIFY_EMAIL=false
JOB_TIMEOUT_SECONDS=300
DEMO_ACCOUNTS=false                # never enable or seed synthetic accounts in production
SHOW_DEMO_ACCOUNTS=false           # shows fill-in buttons only in development/test

# Daily UTC backup of SQLite and the private file store; the latest 14 are retained.
BACKUP_SCHEDULE=false
BACKUP_HOUR_UTC=2
BACKUP_S3_ENDPOINT=                # optional HTTPS S3-compatible endpoint; set all four S3 values
BACKUP_S3_BUCKET=
BACKUP_S3_KEY_ID=
BACKUP_S3_SECRET=

# Observability. Metrics are off when the token is empty; Sentry is optional.
LOG_FORMAT=text                   # text | json
METRICS_TOKEN=
SENTRY_DSN=
TRUST_PROXY=                      # false locally; defaults true on Railway/Fly

# Optional AI assistance (decision support only). AI_PROVIDER=none (the default) makes no external call.
# Under AI_DATA_POLICY=synthetic_only only PDFs whose every page carries the SYNTHETIC stamp line may be sent.
AI_PROVIDER=none                  # none | gemini | groq   (fixture is refused unless APP_ENV=test)
GEMINI_API_KEY=
GROQ_API_KEY=
AI_FALLBACK_PROVIDER=groq         # groq | none
AI_DATA_POLICY=synthetic_only     # allow_real is refused unless AI_PAID_TIER_CONFIRMED=true
AI_PAID_TIER_CONFIRMED=false
AI_DAILY_REQUEST_BUDGET=200
AI_DAILY_PAGE_BUDGET=1000
ROUTING_MIN_CONFIDENCE=0.85
AI_TEST_FAULT=                    # test only: rate_limit | timeout | invalid_json; refused unless APP_ENV=test
